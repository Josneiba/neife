# Copia este archivo a .env.local para trabajar en tu computador (o corre "npm run setup").
# En Vercel estas mismas variables se cargan en Settings > Environment Variables.
# NUNCA subas .env.local a GitHub ni lo compartas.

# --- Base de datos (Supabase / cualquier Postgres) ---------------------------------------------
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (puerto 6543).
# Ejemplo: postgresql://postgres.xxxx:TU_CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# En tu computador puedes usar un Postgres local: postgres://postgres@127.0.0.1:5432/neife
DATABASE_URL=
# Migraciones Prisma: conexión directa/session (puerto 5432). En local puede ser igual a DATABASE_URL.
DIRECT_URL=

# --- Seguridad ---------------------------------------------------------------------------------
# Clave para cifrar relatos y datos de contacto (64 caracteres hexadecimales = 32 bytes).
# Si la pierdes, esos datos NO se pueden recuperar. Guarda una copia en un lugar seguro.
DATA_ENCRYPTION_KEY=
# Clave para firmar las sesiones (mínimo 32 caracteres).
SESSION_SECRET=
# Protege el aviso diario de Vercel Cron (cualquier texto largo).
CRON_SECRET=

# --- Sitio -------------------------------------------------------------------------------------
# Dirección pública, sin barra final. Ej: https://neife.cl  (se usa en correos y en el ingreso con Google)
SITE_URL=http://localhost:3000
# Contacto público; configura al menos CONTACT_EMAIL antes de publicar.
CONTACT_EMAIL=
CONTACT_PHONE=

# --- Correo (Resend) ---------------------------------------------------------------------------
# Sin RESEND_API_KEY los correos se muestran en la consola en vez de enviarse.
RESEND_API_KEY=
# Remitente. Mientras no verifiques tu dominio en Resend, deja el de pruebas (solo envía a tu propio correo).
EMAIL_FROM=Neife <onboarding@resend.dev>

# --- Ingreso con Google (opcional) -------------------------------------------------------------
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (aplicación web).
# URI de redirección autorizada:  {SITE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
